{
  "name": "techpro",
  "version": "2.0.5",
  "description": "TechPro — YouTube channel management, automation, uniqualization & analytics",
  "main": "electron/main.js",
  "author": "TechPro",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "npm run build:win",
    "build:win": "powershell -ExecutionPolicy Bypass -File scripts/bundle_python.ps1 && vite build && electron-builder --win",
    "build:publish": "powershell -ExecutionPolicy Bypass -File scripts/bundle_python.ps1 && vite build && electron-builder --win --publish always",
    "build:frontend": "vite build",
    "bundle:python": "powershell -ExecutionPolicy Bypass -File scripts/bundle_python.ps1",
    "build:backend": "powershell -ExecutionPolicy Bypass -File scripts/build_backend.ps1",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.5",
    "axios": "^1.7.9",
    "canvas-confetti": "^1.9.4",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.9",
    "framer-motion": "^11.11.17",
    "i18next": "^24.2.2",
    "lucide-react": "^0.468.0",
    "node-cron": "^3.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.4.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "vite": "^5.4.11",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.techpro.app",
    "productName": "TechPro",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "scripts",
        "to": "scripts"
      },
      {
        "from": "resources",
        "to": "resources"
      },
      {
        "from": "INSTALL_RU.md",
        "to": "INSTALL_RU.md"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerLanguages": [
        "ru_RU",
        "en_US"
      ],
      "language": "1049",
      "shortcutName": "TechPro",
      "uninstallDisplayName": "TechPro",
      "artifactName": "${productName} Setup ${version}.${ext}",
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "${productName} ${version}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "ProkStudio",
      "repo": "super",
      "releaseType": "release"
    }
  }
}
